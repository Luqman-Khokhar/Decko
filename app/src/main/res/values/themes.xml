<resources>
    <style name="Theme.BigClock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.BigClock.Config" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/config_bg</item>
    </style>

    <style name="ConfigTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/config_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
