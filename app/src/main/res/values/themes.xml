<resources>
    <style name="Theme.BigClock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.BigClock.Config" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/config_bg</item>
    </style>

    <style name="ConfigTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/config_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
    </style>

    <style name="Theme.Decko.Sheet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/controls_bg</item>
        <item name="android:colorAccent">@color/controls_text</item>
    </style>

    <!-- Invisible host for a dialog, e.g. confirming a widget pin over whatever app asked. -->
    <style name="Theme.Decko.Translucent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Light glass; values-night has the dark twin. -->
    <style name="Theme.Decko.Launcher.Glass" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/glass_text</item>
    </style>

    <style name="Theme.Decko.Launcher" parent="android:Theme.Material.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/controls_text</item>
    </style>
</resources>
