<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/stickers_title"
            android:textColor="@color/config_text"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/stickers_hint"
            android:textColor="@color/config_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/config_text_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/allow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stickers_allow"
            android:visibility="gone" />

        <GridLayout
            android:id="@+id/sticker_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4" />
    </LinearLayout>
</ScrollView>
