<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/gen_widget_res.py — edit the script, not this file. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <AnalogClock
            android:id="@+id/widget_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:dial="@drawable/dial_transparent"
            android:hand_hour="@drawable/hand_hour_giant"
            android:hand_minute="@drawable/hand_minute_giant"
            android:hand_second="@drawable/hand_second_giant" />
    </FrameLayout>

    <TextClock
        android:id="@+id/widget_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/day_bg_giant"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE"
        android:maxLines="1"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:textColor="#1F2A44"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black" />
</LinearLayout>
