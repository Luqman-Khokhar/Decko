<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/tab_clocks"
        style="@style/ConfigTab"
        android:text="@string/tab_clocks" />

    <TextView
        android:id="@+id/tab_wallpapers"
        style="@style/ConfigTab"
        android:text="@string/tab_wallpapers" />

    <TextView
        android:id="@+id/tab_widgets"
        style="@style/ConfigTab"
        android:text="@string/tab_widgets" />

    <TextView
        android:id="@+id/tab_header"
        style="@style/ConfigTab"
        android:text="@string/tab_header" />

    <TextView
        android:id="@+id/tab_home"
        style="@style/ConfigTab"
        android:text="@string/tab_home" />
</LinearLayout>
