<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@color/controls_bg"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/design_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:textColor="@color/controls_text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/preview_full"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_control"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/preview_full"
        android:textColor="@color/controls_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/digital_toggle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_control"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/show_digital"
        android:textColor="@color/controls_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/add_widget"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_control"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/add_widget"
        android:textColor="@color/controls_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/lock_screen"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_control"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/set_wallpaper"
        android:textColor="@color/controls_text"
        android:textSize="18sp" />
</LinearLayout>
