<?xml version="1.0" encoding="utf-8"?>
<com.luqman.decko.HomeGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <TextView
                android:id="@+id/remove_bar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/remove_bar_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="@string/drop_to_remove"
                android:textColor="@color/controls_text"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <com.luqman.decko.HomePager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="8dp" />

        <com.luqman.decko.PageIndicator
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <com.luqman.decko.CellLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/dock_bg"
            android:paddingHorizontal="4dp" />

        <TextView
            android:id="@+id/open_drawer"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingHorizontal="16dp"
            android:shadowColor="@color/icon_bg"
            android:shadowRadius="6"
            android:text="@string/open_drawer"
            android:textColor="@color/controls_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:accessibilityPaneTitle="@string/drawer_title"
        android:background="@color/controls_bg"
        android:orientation="vertical"
        android:visibility="invisible">

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:autofillHints=""
            android:background="@drawable/search_bg"
            android:hint="@string/search_apps"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="text|textNoSuggestions"
            android:paddingHorizontal="20dp"
            android:textColor="@color/controls_text"
            android:textColorHint="@color/controls_text_muted"
            android:textSize="16sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:columnWidth="80dp"
                android:numColumns="auto_fit"
                android:paddingHorizontal="8dp"
                android:paddingTop="8dp"
                android:scrollbarStyle="outsideOverlay"
                android:stretchMode="columnWidth" />

            <LinearLayout
                android:id="@+id/drawer_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="48dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/drawer_progress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/drawer_loading" />

                <TextView
                    android:id="@+id/drawer_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/controls_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/drawer_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/retry" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/folder_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:contentDescription="@string/close_folder"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/folder_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="96dp"
            android:accessibilityPaneTitle="@string/folder_default"
            android:background="@drawable/folder_panel_bg"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/folder_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:autofillHints=""
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="@string/folder_name"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textCapWords|textNoSuggestions"
                android:maxLines="1"
                android:textColor="@color/controls_text"
                android:textColorHint="@color/controls_text_muted"
                android:textSize="20sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <GridLayout
                    android:id="@+id/folder_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</com.luqman.decko.HomeGestureLayout>
