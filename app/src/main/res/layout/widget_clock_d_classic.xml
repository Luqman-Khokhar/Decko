<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/gen_widget_res.py — edit the script, not this file. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextClock
            android:id="@+id/widget_time"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoSizeMaxTextSize="96sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="serif"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="24dp"
            android:textColor="#2B2118"
            android:textStyle="bold" />
    </FrameLayout>

    <TextClock
        android:id="@+id/widget_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/day_bg_d_classic"
        android:fontFamily="serif"
        android:textAllCaps="true"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE"
        android:maxLines="1"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:textColor="#3A2D24"
        android:textSize="22sp" />
</LinearLayout>
